    <script>
        // Tailwind script
        function initializeTailwind() {
            document.documentElement.style.setProperty('--accent', '#10b981');
            
            // Optional: Add any interactive JS here
            // For example, make sure all modern-card have nice hover already handled by CSS
        }
        
        // Smooth scroll for anchor links
        function setupSmoothScroll() {
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        }
        
        // Keyboard accessibility: press "/" to focus first tip
        function setupKeyboardShortcuts() {
            document.addEventListener('keydown', function(e) {
                if (e.key === '/' && document.activeElement.tagName === 'BODY') {
                    e.preventDefault();
                    const firstTip = document.querySelector('#tips .modern-card');
                    if (firstTip) firstTip.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });
            
            // Show hint
            const tipSection = document.getElementById('tips');
            if (tipSection) {
                tipSection.addEventListener('mouseenter', function() {
                    // Could add a small toast but skip for cleanliness
                }, { once: true });
            }
        }
        
        // Simple copy functionality for examples (bonus)
        function setupCopyExamples() {
            document.querySelectorAll('.example-box').forEach(box => {
                box.style.cursor = 'pointer';
                box.title = 'اضغط للنسخ';
                
                box.addEventListener('click', () => {
                    const text = box.innerText.trim();
                    navigator.clipboard.writeText(text).then(() => {
                        const originalBg = box.style.backgroundColor;
                        box.style.transition = 'background-color 0.2s';
                        box.style.backgroundColor = '#d1fae5';
                        
                        setTimeout(() => {
                            box.style.backgroundColor = originalBg || '';
                        }, 1200);
                    }).catch(() => {
                        // Fallback for older browsers
                        const textarea = document.createElement('textarea');
                        textarea.value = text;
                        document.body.appendChild(textarea);
                        textarea.select();
                        document.execCommand('copy');
                        document.body.removeChild(textarea);
                    });
                });
            });
        }
        
        // Initialize everything
        function init() {
            initializeTailwind();
            setupSmoothScroll();
            setupKeyboardShortcuts();
            setupCopyExamples();
            
            // Mark page as loaded
            console.log('%c[Clairo] Modern Arabic Grammar Tips page initialized successfully.', 'color:#10b981');
        }
        
        // Boot
        window.onload = init;
    </script>
